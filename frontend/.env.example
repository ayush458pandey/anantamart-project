# =============================================================================
# ANANTAMART FRONTEND - Environment Variables Template
# =============================================================================
# Copy to .env.local for local development
# Add to Vercel Dashboard → Settings → Environment Variables for production
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API base URL
# Local: http://localhost:8000/api
# Production: https://api.ananta-mart.in/api
# Versioned alternative (recommended for new integrations): .../api/v1
VITE_API_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# Payment Configuration
# -----------------------------------------------------------------------------
# Razorpay Key ID (public key - safe to expose in frontend)
# Get from: https://dashboard.razorpay.com/app/keys
# Test: rzp_test_xxx | Live: rzp_live_xxx
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# UPI ID for QR code payments
VITE_UPI_ID=your-upi-id@bank

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# Vercel Analytics (auto-enabled when deployed to Vercel)
# VITE_VERCEL_ANALYTICS_ID=auto

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable features
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=false